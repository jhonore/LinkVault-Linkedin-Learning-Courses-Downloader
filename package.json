    "verify:ui": "make verify-ui",
    "verify:youtube-ui": "make verify-youtube-ui",
    "verify:linkedin-artifact-row": "make verify-linkedin-artifact-row",
    "verify:no-any": "make verify-no-any",
    "verify:visual": "make verify-visual",
    "verify:tauri-smoke": "make verify-tauri-smoke",
    "verify:release": "make verify-release",
    "verify:installer": "make verify-installer",
    "verify:release-manifest": "make verify-release-manifest",
    "cargo:test": "make cargo-test",
    "cargo:clippy": "make cargo-clippy"
  }
